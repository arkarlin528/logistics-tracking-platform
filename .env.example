# Copy to .env and change every value. .env is git-ignored; never commit real secrets.

# SQL Server 'sa' password: 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Change_me_Str0ng!

# 32+ random characters. Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# Shared secret the freight-data-pipeline sends as X-Api-Key.
RATE_IMPORT_API_KEY=change-me

# Password for the demo accounts (admin@ / dispatcher@ / customer@demo.test).
# Must match demoPassword in web/src/environments/environment.prod.ts, which shows it on the login page.
DEMO_PASSWORD=Demo#Logistics2026

# Host port for the web app.
WEB_PORT=8080
